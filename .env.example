# Environment Variables Example for FPT ICO Summit 2026

# Server-only MongoDB connection URI (Do NOT expose to browser or add NEXT_PUBLIC_ prefix)
MONGODB_URI=

# Database name
MONGODB_DB_NAME=fpt_ico_summit

# Auth.js / NextAuth v5 Secret Key (Generate using `npx auth secret` or `openssl rand -hex 32`)
AUTH_SECRET=

# Cloudinary Media Storage (Server-only credentials for signed logo upload)
CLOUDINARY_CLOUD_NAME=dvucotc8z
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_LOGO_PRESET=fpt_ico_partner_logo
CLOUDINARY_COVER_PRESET=fpt_ico_partner_cover
CLOUDINARY_SCHOLARSHIP_PRESET=fpt_ico_scholarship_banner
CLOUDINARY_ACTIVITY_IMAGE_PRESET=fpt_ico_activity_image

